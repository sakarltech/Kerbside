# =============================================================================
# KerbSide Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values

# Database
# PostgreSQL connection string
DATABASE_URL="postgresql://kerbside:kerbside_secret@localhost:5432/kerbside"

# NextAuth.js
# Base URL of your application
NEXTAUTH_URL="http://localhost:3000"
# Secret key for JWT signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Stripe
# Your Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# Your Stripe publishable key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
# Stripe webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Application
# Set to 'production' in production environments
NODE_ENV="development"
